// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
  engineType    = "library"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================
// TOURS
// ============================================

model Tour {
  id          Int      @id @default(autoincrement())
  adminTitle  String   // nombre interno para el panel admin
  price       Decimal  @db.Decimal(10, 2)
  location    String?  // dato interno (spec 006)
  duration    Int?     // minutos, dato interno (spec 006)
  img         String?  // portada derivada: la escribe solo la API (= images[0])
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relaciones
  categoryId  Int
  category    Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  translations TourTranslation[]
  images      TourImage[]

  @@index([categoryId])
  @@index([isActive])
}

// Fotos de la galería de un tour, en orden (spec 006). Misma forma que en la rama de la spec 003.
model TourImage {
  id       Int    @id @default(autoincrement())
  tourId   Int
  tour     Tour   @relation(fields: [tourId], references: [id], onDelete: Cascade)
  filename String // solo el nombre: "abc.jpg" (la URL se arma con GET /upload/:filename)
  position Int    // 0 = portada

  @@index([tourId, position])
}

model TourTranslation {
  id          Int    @id @default(autoincrement())
  title       String
  description String

  tourId Int
  tour   Tour @relation(fields: [tourId], references: [id], onDelete: Cascade)

  languageId Int      @default(1)  // temporal, ajustar desde admin
  language   Language @relation(fields: [languageId], references: [id], onDelete: Cascade)

  @@unique([tourId, languageId])
  @@index([languageId])
}

// ============================================
// CATEGORIES
// ============================================

model Category {
  id          Int    @id @default(autoincrement())
  adminName   String @unique // identificador interno para el panel admin
  description String // descripción interna para el admin

  // Relaciones
  translations CategoryTranslation[]
  tours        Tour[]

  @@index([adminName])
}

model CategoryTranslation {
  id          Int    @id @default(autoincrement())
  name        String // nombre visible para usuarios
  description String // descripción visible para usuarios

  categoryId Int
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  languageId Int
  language   Language @relation(fields: [languageId], references: [id], onDelete: Cascade)

  @@unique([categoryId, languageId])
  @@index([languageId])
}

// ============================================
// USERS
// ============================================

model User {
  id        Int      @id @default(autoincrement())
  email     String   @unique
  password  String   // bcrypt hash
  name      String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([email])
}

// ============================================
// LANGUAGES
// ============================================

model Language {
  id          Int    @id @default(autoincrement())
  code        String @unique // 'es', 'en', 'fr', etc.
  name        String // 'Español', 'English', 'Français', etc.
  isActive    Boolean @default(true)

  tourTranslations     TourTranslation[]
  categoryTranslations CategoryTranslation[]

  @@index([code])
}

// ============================================
// SOCIAL (spec 007)
// ============================================

// Una sola fila (id = 1): enlaces de redes y número de WhatsApp de la web (spec 007).
model SocialSettings {
  id               Int      @id @default(1)
  facebookUrl      String?
  facebookVisible  Boolean  @default(false)
  instagramUrl     String?
  instagramVisible Boolean  @default(false)
  linkedinUrl      String?
  linkedinVisible  Boolean  @default(false)
  whatsappNumber   String   @default("529841681263")
  updatedAt        DateTime @updatedAt
}
