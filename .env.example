# Database
DATABASE_URL=postgresql://user:password@localhost:5432/tropical_vitamin

# JWT Authentication (min 32 characters; the API will not start without it)
JWT_SECRET=change-me-at-least-32-characters-long

# Auth0 (customer accounts)
AUTH0_DOMAIN=your-tenant.us.auth0.com
AUTH0_AUDIENCE=https://api.example.com

# Agency inbox for booking notifications
AGENCY_EMAIL=agency@example.com

# Email (SMTP)
MAIL_HOST=smtp.example.com
MAIL_PORT=587
MAIL_USER=user@example.com
MAIL_PASS=change-me
MAIL_FROM=no-reply@example.com

# SeaweedFS / S3 Storage
S3_ENDPOINT=https://s3.example.com
S3_ACCESS_KEY=example
S3_SECRET_KEY=change-me
S3_BUCKET=example-bucket
S3_PUBLIC_URL=https://s3.example.com/example-bucket
